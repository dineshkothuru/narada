# Supabase transaction pooler for serverless/Vercel (URL-encode the password).
DATABASE_URL=postgres://postgres.<project-ref>:<url-encoded-password>@<transaction-pooler-host>:6543/postgres?sslmode=require
OPENROUTER_API_KEY=
SARVAM_API_KEY=
# Optional: only needed for dish-photo uploads through Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# any long random string; signs staff login cookies (openssl rand -hex 32)
SESSION_SECRET=
# Optional locally; set for shared rate limits across multiple Railway instances.
REDIS_URL=
# Optional; leave empty unless the deployment has a confirmed proxy hop count.
TRUST_PROXY_HOPS=
