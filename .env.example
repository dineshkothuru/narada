DATABASE_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
GEMINI_API_KEY=
SARVAM_API_KEY=
# Optional: only needed for dish-photo uploads through Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# any long random string; signs staff login cookies (openssl rand -hex 32)
SESSION_SECRET=
# Optional locally; set for shared rate limits across multiple Railway instances.
REDIS_URL=
# Optional; leave empty unless the deployment has a confirmed proxy hop count.
TRUST_PROXY_HOPS=
# Optional one-time bootstrap for the first active admin. Username, first name,
# and password are required together; last name and outlet slug are optional.
# Password must be 15-128 characters. Remove these values after first login.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_FIRST_NAME=
ADMIN_BOOTSTRAP_LAST_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_OUTLET_SLUG=
