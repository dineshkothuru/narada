{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["test/server-only-stub.ts"],
      "project": ["test/**/*.ts"]
    },
    "web": {
      "next": {
        "entry": ["middleware.ts"]
      }
    },
    "apps/api": {
      "ignore": ["src/db/**"],
      "ignoreDependencies": ["@narada/shared", "kysely", "pg", "zod", "@types/pg"]
    },
    "apps/web": {
      "vite": {},
      "ignoreDependencies": ["lucide-react"]
    },
    "packages/shared": {
      "ignore": ["src/schemas/**"],
      "ignoreDependencies": ["zod"]
    }
  },
  "ignoreExportsUsedInFile": true
}
