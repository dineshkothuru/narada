{
  "name": "narada",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm --filter @narada/web build",
    "dev": "pnpm run dev:api & pnpm run dev:web & wait",
    "dev:api": "pnpm --filter @narada/api dev",
    "dev:web": "pnpm --filter @narada/web dev",
    "lint": "eslint . && pnpm --filter @narada/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "fastify": "^5"
  },
  "devDependencies": {
    "vitest": "4.1.11",
    "@vitejs/plugin-react": "^5",
    "prettier": "3.9.6",
    "knip": "6.34.0",
    "lint-staged": "17.4.1",
    "simple-git-hooks": "2.14.0",
    "@types/node": "^24",
    "eslint": "^9",
    "typescript-eslint": "^8",
    "typescript": "^5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,md}": "prettier --write",
    "apps/web/**/*.{ts,tsx}": "eslint --config apps/web/eslint.config.js --fix",
    "{apps/api,packages}/**/*.{ts,tsx}": "eslint --fix"
  }
}
